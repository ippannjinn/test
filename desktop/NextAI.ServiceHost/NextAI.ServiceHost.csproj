<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NextAI.ServiceHost</AssemblyName>
    <RootNamespace>NextAI.ServiceHost</RootNamespace>
    <Version>1.0.0</Version>
    <Company>NextAI Platform</Company>
    <Product>NextAI Platform</Product>
    <Description>NextAI Platform server host (Windows service)</Description>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\Common\Json.cs;..\Common\InstallInfo.cs;..\Common\ProcessRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
