<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NextAI.Admin</AssemblyName>
    <RootNamespace>NextAI.Admin</RootNamespace>
    <Version>1.0.0</Version>
    <Company>NextAI Platform</Company>
    <Product>NextAI Platform</Product>
    <Description>NextAI Platform 管理コンソール</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon>..\Assets\nextai.ico</ApplicationIcon>
    <ApplicationManifest>..\Assets\app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\Common\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
